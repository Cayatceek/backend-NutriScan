[Unit]
Description=NutriScan backend docker compose stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/nutriscan-backend
ExecStart=/usr/bin/docker compose -f deploy/docker-compose.prod.yml --env-file deploy/.env.production up -d --build
ExecStop=/usr/bin/docker compose -f deploy/docker-compose.prod.yml --env-file deploy/.env.production down
RemainAfterExit=yes
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
